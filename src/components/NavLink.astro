---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;

const { pathname } = Astro.url;
const normalizedPathname = pathname.replace(/\/$/, "");
const isActive =
  href === pathname || href === normalizedPathname || (href !== "/" && normalizedPathname.startsWith(`${href}/`));
---

<a aria-current={isActive ? "page" : undefined} class={className} data-nav-link href={href} {...props}>
  <slot />
</a>
