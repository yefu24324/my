---
import { Icon } from "@astrojs/starlight/components";

import TableOfContentsList from "./components-internals/TableOfContents/TableOfContentsList.astro";

const { toc } = Astro.locals.starlightRoute;
---

{toc && (
  <nav aria-labelledby="starlight__on-this-page" class="flex min-h-0 flex-1 flex-col">
    <h3 class="inline-flex items-center gap-1.5 text-sm text-fd-muted-foreground" id="toc-title">
      {/* <Text class="size-4" /> */}
      <Icon color="goldenrod" name="list-format" size="1rem" />
      {Astro.locals.t("tableOfContents.onThisPage")}
    </h3>
    <TableOfContentsList toc={toc.items} />
  </nav>
)}
