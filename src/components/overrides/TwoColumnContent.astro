---
const { toc } = Astro.locals.starlightRoute;
---

{!toc && <slot />}

{toc && (
  <div class="flex w-full max-w-3xl mx-auto">
    <slot />
    <div class="sticky top-0 self-start flex h-[calc(100dvh-10rem)] w-64 shrink-0 flex-col pt-12 pe-4 pb-2 ml-4 max-xl:hidden">
      <slot name="right-sidebar" />
    </div>
  </div>
)}

