---
import type { MarkdownHeading } from "astro";

interface TocItem extends MarkdownHeading {
  children: TocItem[];
}

interface Props {
  depth?: number;
  isMobile?: boolean;
  toc: TocItem[];
}

const { toc } = Astro.props;

/* 拍平成 Fumadocs 的扁平结构（缩进按 depth 计算，和 fumadocs default.tsx 一致） */
type FlatItem = { depth: number; slug: string; text: string };

const items: FlatItem[] = [];
const flatten = (list: TocItem[]) => {
  for (const item of list) {
    items.push({ depth: item.depth, slug: item.slug, text: item.text });
    if (item.children.length > 0) flatten(item.children);
  }
};
flatten(toc);

/* fumadocs default.tsx：BASE = 8，depth <= 2 → 20px，depth 3 → 32px，更深 → 44px */
const BASE = 8;
const getItemOffset = (depth: number) => {
  if (depth <= 2) return 12 + BASE;
  if (depth === 3) return 24 + BASE;
  return 36 + BASE;
};
---

<div class="toc-scroll" data-toc-scroll>
  <div class="toc-items" data-toc-items>
    <div aria-hidden="true" class="toc-rail" data-toc-rail></div>
    {items.length === 0 && <div class="toc-empty">No Headings</div>}
    {items.map((item) => (
  <a
    class="toc-item"
    data-depth={item.depth}
    href={`#${item.slug}`}
    style={`padding-inline-start: ${getItemOffset(item.depth)}px`}
  >
    {item.text}
  </a>
))}
  </div>
</div>

<style>
/* ============ TOCScrollArea（fumadocs TOCScrollArea 的等价物） ============ */
.toc-scroll {
  position: relative;
  min-height: 0;
  padding-block: 0.75rem;
  overflow-x: clip;
  overflow-y: auto;
  overscroll-behavior: contain;
  font-size: 0.875rem;
  scrollbar-width: none;
  -webkit-mask-image: linear-gradient(to bottom, transparent, #fff 16px, #fff calc(100% - 16px), transparent);
  mask-image: linear-gradient(to bottom, transparent, #fff 16px, #fff calc(100% - 16px), transparent);
}
.toc-scroll::-webkit-scrollbar {
  display: none;
}

/* ============ TOCItems ============ */
.toc-items {
  position: relative;
  display: flex;
  flex-direction: column;
}

.toc-rail {
  position: absolute;
  top: 0;
  left: 0;
  pointer-events: none;
}

/* ============ TOCItem ============ */
.toc-item {
  position: relative;
  padding-block: 0.375rem;
  color: var(--muted-foreground);
  overflow-wrap: anywhere;
  text-decoration: none;
  transition: color 150ms ease;
}

.toc-item:hover {
  color: color-mix(in oklab, var(--foreground) 72%, var(--muted-foreground));
}

.toc-item[data-active] {
  color: var(--foreground);
}

.toc-item:first-of-type {
  padding-block-start: 0;
}

.toc-item:last-of-type {
  padding-block-end: 0;
}

/* ============ 空状态（fumadocs TOCEmpty） ============ */
.toc-empty {
  padding: 0.75rem;
  font-size: 0.75rem;
  color: var(--muted-foreground);
  background-color: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius, 0.5rem);
}
</style>

<script>
/**
 * Fumadocs 默认 TOC 的 Astro 移植：
 * - 依据条目测量生成左侧导轨路径（含深度切换的曲线段）
 * - 当前段落范围用亮色裁剪高亮，圆点沿路径移动（fumadocs thumb）
 * - 滚动跟踪：视口阈值上方最近的标题为当前项；页面底部时最后一项
 */
const BASE = 8;
const lineOffset = (depth: number) => (depth <= 2 ? BASE : depth === 3 ? 8 + BASE : 16 + BASE);

function initTOC(root: Element) {
  const container = root.querySelector<HTMLElement>("[data-toc-items]");
  const rail = root.querySelector<HTMLElement>("[data-toc-rail]");
  if (!container || !rail) return;

  const links = Array.from(container.querySelectorAll<HTMLAnchorElement>("a.toc-item"));
  if (links.length === 0) return;

  const NS = "http://www.w3.org/2000/svg";
  const svg = document.createElementNS(NS, "svg");
  svg.setAttribute("aria-hidden", "true");
  svg.style.position = "absolute";
  svg.style.top = "0";
  svg.style.left = "0";
  svg.style.overflow = "visible";

  const railPath = document.createElementNS(NS, "path");
  railPath.setAttribute("fill", "none");
  railPath.setAttribute("stroke-width", "1");
  railPath.style.stroke = "color-mix(in oklab, var(--foreground) 12%, transparent)";

  const trackPath = document.createElementNS(NS, "path");
  trackPath.setAttribute("fill", "none");
  trackPath.setAttribute("stroke-width", "1");
  trackPath.style.stroke = "var(--foreground)";
  trackPath.style.transition = "clip-path 200ms ease";

  svg.append(railPath, trackPath);

  const thumb = document.createElement("div");
  thumb.style.position = "absolute";
  thumb.style.top = "0";
  thumb.style.left = "0";
  thumb.style.width = "5px";
  thumb.style.height = "5px";
  thumb.style.borderRadius = "9999px";
  thumb.style.background = "var(--foreground)";
  thumb.style.opacity = "0";
  thumb.style.transition = "transform 200ms ease, opacity 200ms ease";

  rail.append(svg, thumb);

  let positions: [number, number, number][] = [];
  let lineLengths: [number, number][] = [];

  function measure() {
    const segments: string[] = [];
    positions = [];
    links.forEach((el, i) => {
      const cs = getComputedStyle(el);
      const x = lineOffset(Number(el.dataset.depth ?? 2)) + 0.5;
      const top = el.offsetTop + Number.parseFloat(cs.paddingTop);
      const bottom = el.offsetTop + el.clientHeight - Number.parseFloat(cs.paddingBottom);
      if (i === 0) {
        segments.push(`M${x} ${top} L${x} ${bottom}`);
      } else {
        const [, upperBottom, upperX] = positions[i - 1];
        segments.push(` C ${upperX} ${top - 4} ${x} ${upperBottom + 4} ${x} ${top} L${x} ${bottom}`);
      }
      positions.push([top, bottom, x]);
    });

    const width = Math.max(...positions.map(([, , x]) => x + 9));
    const height = Math.max(...positions.map(([, bottom]) => bottom));
    svg.setAttribute("viewBox", `0 0 ${width} ${height}`);
    svg.setAttribute("width", String(width));
    svg.setAttribute("height", String(height));

    const d = segments.join("");
    railPath.setAttribute("d", d);
    trackPath.setAttribute("d", d);

    const total = railPath.getTotalLength();
    lineLengths = [];
    for (let i = 0; i < positions.length; i++) {
      const [top, bottom] = positions[i];
      let l = i > 0 ? lineLengths[i - 1][1] + (top - positions[i - 1][1]) : top;
      while (l < total && railPath.getPointAtLength(l).y < top) l += 1;
      lineLengths.push([l, l + (bottom - top)]);
    }
  }

  let activeIndex = -1;
  function setActive(index: number) {
    if (index === activeIndex) return;
    activeIndex = index;

    links.forEach((el, i) => {
      const isActive = i === index;
      el.toggleAttribute("data-active", isActive);
      if (isActive) el.setAttribute("aria-current", "true");
      else el.removeAttribute("aria-current");
    });

    if (index < 0 || !positions[index]) {
      thumb.style.opacity = "0";
      return;
    }

    const [top, bottom] = positions[index];
    trackPath.style.clipPath = `polygon(0 ${Math.max(top - 1, 0)}px, 100% ${Math.max(top - 1, 0)}px, 100% ${
      bottom + 1
    }px, 0 ${bottom + 1}px)`;

    const point = railPath.getPointAtLength(lineLengths[index][0]);
    thumb.style.transform = `translate(${point.x - 2.5}px, ${point.y - 2.5}px)`;
    thumb.style.opacity = "1";
  }

  function update() {
    /* 与原生锚点跳转对齐：标题跳转落点由 html 的 scroll-padding-top 决定，
       阈值必须覆盖它，否则点击跳转后高亮会停在上一项 */
    const scrollPaddingTop = Number.parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
    const headerHeight = document.querySelector("header")?.getBoundingClientRect().height ?? 0;
    const threshold = Math.max(scrollPaddingTop, headerHeight + 32) + 1;
    let index = 0;

    links.forEach((el, i) => {
      const id = decodeURIComponent(el.hash.slice(1));
      const heading = document.getElementById(id);
      if (!heading) return;
      if (heading.getBoundingClientRect().top <= threshold) index = i;
    });

    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    if (atBottom) index = links.length - 1;

    setActive(index);
  }

  let queued = false;
  const onScroll = () => {
    if (queued) return;
    queued = true;
    setTimeout(() => {
      queued = false;
      update();
    }, 0);
  };

  measure();
  update();
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", () => {
    measure();
    update();
  });
  new ResizeObserver(() => {
    measure();
    update();
  }).observe(container);
  document.fonts?.ready.then(() => {
    measure();
    update();
  });
}

document.querySelectorAll("[data-toc-scroll]").forEach(initTOC);
</script>
